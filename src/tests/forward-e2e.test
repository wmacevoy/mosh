#!/bin/sh

#
# End-to-end test of port forwarding: starts a real mosh-server and
# mosh-client and sends TCP and UDP through -L, -R, -LU and -RU.
#

if ! command -v python3 >/dev/null 2>&1; then
    printf "forward-e2e: python3 not found\n" >&2
    exit 77
fi

. "$(dirname "$0")/e2e-test-subrs"
if ! set_locale "$(dirname "$0")"; then
    printf "forward-e2e: no usable locale\n" >&2
    exit 77
fi

exec python3 "$(dirname "$0")/forward-e2e.py" ../frontend/mosh-server ../frontend/mosh-client
