#!/bin/sh

#
# Sessions carried by the relay, for when UDP cannot reach the server:
# from the start; found by the client for itself when UDP gets no
# answer; with the server's address not what the relay was told; over
# IPv6; and with the relay's connection lost part way.
# The remote relay is run directly here, where ssh would run it.
#

if ! command -v python3 >/dev/null 2>&1; then
    printf "relay.test: python3 not found\n" >&2
    exit 77
fi

. "$(dirname "$0")/e2e-test-subrs"
if ! set_locale; then
    printf "relay.test: no usable locale\n" >&2
    exit 77
fi

smoke="$(dirname "$0")/headless-smoke.py"
status=0
for how in "127.0.0.1 always" "127.0.0.1 blocked" "127.0.0.1 translated"; do
    printf '%s\n' "--- $how"
    python3 "$smoke" ../frontend/mosh-server ../frontend/mosh-client $how || status=1
done

# IPv6, if this machine has it
if python3 -c 'import socket; socket.socket(socket.AF_INET6, socket.SOCK_DGRAM).bind(("::1", 0))' 2>/dev/null; then
    printf '%s\n' "--- ::1 blocked"
    python3 "$smoke" ../frontend/mosh-server ../frontend/mosh-client ::1 blocked || status=1
fi
exit $status
